<view class="tabbar">
  <view class="tab {{selected === index ? 'active' : ''}}"
        wx:for="{{list}}" wx:key="pagePath"
        data-path="{{item.pagePath}}" data-index="{{index}}"
        bindtap="switchTab">
    <text class="ti">{{item.icon}}</text>
    <text class="tt">{{item.text}}</text>
  </view>
</view>