.hist-card {
  background: var(--bg-surface); border-radius: var(--r-card);
  box-shadow: var(--shadow-sm); padding: 28rpx;
  margin-bottom: 22rpx; display: flex; align-items: center;
}
.hist-thumb {
  width: 124rpx; height: 124rpx; border-radius: 26rpx;
  background: linear-gradient(135deg, #FFE3CC, #FFC79A);
  display: flex; align-items: center; justify-content: center;
  font-size: 50rpx; margin-right: 24rpx; flex-shrink: 0;
}
.hist-info { flex: 1; min-width: 0; }
.hist-t { font-size: 30rpx; font-weight: 600; }
.hist-s { font-size: 25rpx; color: var(--text-secondary); margin-top: 6rpx; }
.hist-m { font-size: 23rpx; color: var(--text-tertiary); margin-top: 8rpx; display: flex; gap: 18rpx; }

.empty { text-align: center; padding: 140rpx 60rpx; }
.ei { font-size: 96rpx; margin-bottom: 24rpx; opacity: .8; }
.et { font-size: 34rpx; font-weight: 600; }
.es { font-size: 28rpx; color: var(--text-secondary); margin-top: 14rpx; }