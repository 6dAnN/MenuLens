/* Hero */
.hero { position: relative; margin: 0 -40rpx; }
.hero-img {
  height: 500rpx; position: relative; overflow: hidden;
  background: linear-gradient(160deg, #FFE9D2 0%, #FFD9B8 40%, #FFC49B 100%);
}
.hero-food { position: absolute; left: 0; right: 0; top: 88rpx; bottom: 0; }

.plate {
  position: absolute; left: 50%; top: 52%;
  width: 380rpx; height: 380rpx; margin: -190rpx 0 0 -190rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 42% 34%, #FFFFFF 0%, #FFF6EE 45%, #F3E2D2 78%, #E8D2BE 100%);
  box-shadow: 0 28rpx 64rpx rgba(120,70,30,.28), inset 0 -12rpx 30rpx rgba(150,100,60,.14);
}
.fd {
  position: absolute; border-radius: 50%;
  box-shadow: inset 0 -4rpx 10rpx rgba(90,40,10,.25);
}
.fd1 { width: 118rpx; height: 96rpx;  left: 148rpx; top: 232rpx; background: radial-gradient(circle at 36% 30%, #F0B45C, #C4622A); border-radius: 46% 54% 52% 48%; }
.fd2 { width: 100rpx; height: 84rpx;  left: 250rpx; top: 268rpx; background: radial-gradient(circle at 40% 32%, #E97B4A, #A83C1C); border-radius: 52% 48% 44% 56%; }
.fd3 { width: 86rpx;  height: 74rpx;  left: 204rpx; top: 178rpx; background: radial-gradient(circle at 38% 30%, #8FBE5A, #4E7A2C); }
.fd4 { width: 64rpx;  height: 54rpx;  left: 282rpx; top: 214rpx; background: radial-gradient(circle at 40% 32%, #F3D06A, #C79A24); }
.fd5 { width: 74rpx;  height: 60rpx;  left: 160rpx; top: 300rpx; background: radial-gradient(circle at 40% 32%, #F6E3B0, #CBA35C); }

.steam { position: absolute; left: 50%; margin-left: -74rpx; width: 148rpx; height: 160rpx; top: 30rpx; }
.steam .s1, .steam .s2, .steam .s3 {
  position: absolute; bottom: 0; width: 22rpx; border-radius: 14rpx;
  background: rgba(255,255,255,.62); filter: blur(10rpx);
  animation: steamRise 3.4s ease-in-out infinite;
}
.steam .s1 { left: 20rpx;  height: 80rpx;  animation-delay: 0s; }
.steam .s2 { left: 62rpx;  height: 118rpx; animation-delay: .7s; }
.steam .s3 { left: 104rpx; height: 74rpx;  animation-delay: 1.4s; }
@keyframes steamRise {
  0%   { opacity: 0; transform: translateY(22rpx) scaleX(.85); }
  35%  { opacity: .85; }
  100% { opacity: 0; transform: translateY(-92rpx) scaleX(1.25); }
}

.hero-content { padding: 28rpx 40rpx 0; }
.hero-brand { display: flex; align-items: center; }
.logo { font-size: 48rpx; font-weight: 800; letter-spacing: -1rpx; color: var(--brand-primary); }
.hero-tag {
  font-size: 20rpx; font-weight: 700; color: #fff;
  background: var(--brand-gradient); padding: 4rpx 14rpx;
  border-radius: 12rpx; margin-left: 14rpx;
}
.hero-slogan { font-size: 28rpx; color: var(--text-secondary); margin-top: 4rpx; }

.scan-cta {
  position: relative; margin: -54rpx 40rpx 0;
  height: 112rpx; background: var(--brand-gradient);
  color: #fff; border-radius: 32rpx;
  font-size: 34rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--brand-shadow);
}
.scan-cta:active { transform: scale(.98); }

/* 次入口 */
.quick-grid { display: flex; flex-wrap: wrap; margin-top: 36rpx; }
.quick-card {
  width: calc(50% - 12rpx); background: var(--bg-surface);
  border-radius: var(--r-card); box-shadow: var(--shadow-sm);
  padding: 36rpx 32rpx; margin-bottom: 24rpx;
  display: flex; flex-direction: column;
}
.quick-card:nth-child(odd) { margin-right: 24rpx; }
.quick-card:active { transform: scale(.98); }
.quick-card .qi { font-size: 52rpx; line-height: 1; }
.quick-card .qt { font-size: 30rpx; font-weight: 600; margin-top: 16rpx; }
.quick-card .qs { font-size: 24rpx; color: var(--text-tertiary); margin-top: 6rpx; }

/* 忌口条 */
.avoid-bar {
  margin-top: 12rpx; background: var(--bg-brand-soft);
  border-radius: var(--r-card); padding: 26rpx 30rpx;
  display: flex; align-items: center;
}
.ab-icon { font-size: 32rpx; margin-right: 16rpx; }
.ab-text { font-size: 26rpx; color: var(--text-secondary); flex: 1; }
.ab-edit { font-size: 26rpx; color: var(--brand-primary); font-weight: 600; }

/* 对话入口 */
.chat-entry {
  margin-top: 28rpx; height: 108rpx; background: var(--bg-surface);
  border-radius: var(--r-card); box-shadow: var(--shadow-sm);
  display: flex; align-items: center; padding: 0 32rpx;
}
.ce-icon {
  width: 64rpx; height: 64rpx; border-radius: 20rpx;
  background: var(--brand-gradient); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; margin-right: 22rpx;
}
.ce-txt { font-size: 28rpx; color: var(--text-tertiary); }

/* AI 引擎状态条——如实告诉用户当前谁在推理 */
.engine-bar {
  margin-top: 20rpx;
  display: flex; align-items: center; justify-content: center;
  padding: 16rpx 0;
}
.eb-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  margin-right: 12rpx;
}
.engine-bar.live .eb-dot {
  background: var(--success);
  box-shadow: 0 0 0 6rpx rgba(47,168,79,.14);
}
.engine-bar.offline .eb-dot { background: var(--warning); }
.eb-txt { font-size: 23rpx; color: var(--text-tertiary); }