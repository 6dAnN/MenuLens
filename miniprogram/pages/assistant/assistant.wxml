<!-- AI 小助手聊天页 -->
<view class="chat-page">
  <!-- 顶栏 -->
  <view class="chat-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="cn-back" bindtap="onBack">‹</view>
    <view class="cn-title">
      <text class="cn-name">AI 小助手</text>
      <text class="cn-status {{remoteLive ? 'live' : ''}}">
        {{remoteLive ? '● 云端模型在线' : '● 本地引擎'}}
      </text>
    </view>
    <view class="cn-clear" bindtap="clearAll">清空</view>
  </view>

  <!-- 消息区 -->
  <scroll-view class="chat-body" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view
      class="msg {{item.role === 'user' ? 'msg-user' : 'msg-ai'}}"
      wx:for="{{messages}}"
      wx:key="index"
      id="msg-{{index}}"
    >
      <view class="msg-avatar" wx:if="{{item.role === 'assistant'}}">✦</view>
      <view class="msg-wrap">
        <view class="msg-bubble {{item.failed ? 'failed' : ''}} {{item.stopped ? 'stopped' : ''}}">
          <text class="msg-text" user-select>{{item.text}}</text>
          <!-- 首字还没回来时给一个真实的状态说明，不是空转菊花 -->
          <text class="msg-cursor" wx:if="{{item.pending && sending}}">正在检索知识库…</text>
          <text class="msg-stamp" wx:if="{{item.stopped}}">已停止</text>
        </view>

        <!-- 出错重试：不用重新打字 -->
        <view class="msg-retry" wx:if="{{item.failed}}" bindtap="retry" data-i="{{index}}">
          ↻ 重试这一条
        </view>

        <!-- 检索依据：让用户能核查 AI 引用了什么 -->
        <view
          class="msg-src"
          wx:if="{{item.role === 'assistant' && item.hits.length > 0}}"
          bindtap="toggleHits"
          data-i="{{index}}"
        >
          <text class="src-toggle">
            {{expanded === index ? '▾' : '▸'}} 依据 {{item.hits.length}} 条
          </text>
          <view class="src-list" wx:if="{{expanded === index}}">
            <view class="src-item" wx:for="{{item.hits}}" wx:for-item="h" wx:key="title">
              <text class="src-title">{{h.title}}</text>
              <text class="src-meta">{{h.source}} · 匹配度 {{h.score}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="msg-avatar user" wx:if="{{item.role === 'user'}}">我</view>
    </view>
    <view style="height:40rpx"></view>
    <view id="msg-end"></view>
  </scroll-view>

  <!-- 分组快捷提问 -->
  <view class="quick-panel" wx:if="{{showSuggestions}}">
    <view class="quick-tabs">
      <view
        class="quick-tab {{activeGroup === item.key ? 'on' : ''}}"
        wx:for="{{groups}}"
        wx:key="key"
        bindtap="switchGroup"
        data-key="{{item.key}}"
      >
        <text class="qt-icon">{{item.icon}}</text>{{item.label}}
      </view>
    </view>
    <view class="quick-list">
      <block wx:for="{{groups}}" wx:for-item="g" wx:key="key">
        <view
          class="quick-chip"
          wx:if="{{activeGroup === g.key}}"
          wx:for="{{g.items}}"
          wx:for-item="q"
          wx:key="*this"
          bindtap="quickAsk"
          data-q="{{q}}"
        >{{q}}</view>
      </block>
    </view>
  </view>

  <!-- 输入栏 -->
  <view class="chat-input-bar">
    <input
      class="chat-input"
      placeholder="{{sending ? '生成中…点右侧可停止' : '问我关于菜的问题…'}}"
      value="{{inputValue}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="send"
      disabled="{{sending}}"
    />
    <!-- 生成中时「发送」变成「停止」，同一个位置不新增控件 -->
    <view
      class="chat-send {{sending ? 'stop' : ''}} {{!sending && !inputValue ? 'disabled' : ''}}"
      bindtap="{{sending ? 'stopGenerate' : 'send'}}"
    >{{sending ? '停止' : '发送'}}</view>
  </view>

  <view class="kb-foot" wx:if="{{kbStats}}">
    知识库 {{kbStats.chunks}} 条 · 本地检索增强 · 答案仅供参考
  </view>
</view>
