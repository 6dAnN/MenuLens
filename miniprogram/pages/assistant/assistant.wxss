/* AI 小助手聊天页 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFFBF7;
}

/* 顶栏 */
.chat-nav {
  display: flex;
  align-items: center;
  padding: 0 24rpx 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0ece8;
}
.cn-back {
  font-size: 52rpx;
  color: #FF6B35;
  width: 72rpx;
  line-height: 1;
}
.cn-title {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cn-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2E2A26;
}
.cn-status {
  font-size: 22rpx;
  color: #C9A227;
  margin-top: 2rpx;
}
.cn-status.live { color: #52C41A; }
.cn-clear {
  width: 72rpx;
  text-align: right;
  font-size: 25rpx;
  color: #9c9088;
}

/* 消息区 */
.chat-body {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
  overflow-y: auto;
}
.msg {
  display: flex;
  margin-bottom: 28rpx;
  align-items: flex-start;
}
.msg-user { flex-direction: row-reverse; }
.msg-ai { flex-direction: row; }

.msg-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8A3D, #FF5F6D);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}
.msg-user .msg-avatar {
  background: #f0ece8;
  color: #7a6f66;
  font-size: 26rpx;
}

.msg-bubble {
  max-width: 72%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  margin: 0 16rpx;
  word-break: break-all;
}
.msg-user .msg-bubble {
  background: #FF6B35;
  box-shadow: 0 2rpx 12rpx rgba(255,107,53,0.2);
}
.msg-text {
  font-size: 29rpx;
  line-height: 1.6;
  color: #2E2A26;
  white-space: pre-wrap;
}
.msg-user .msg-text { color: #fff; }
.msg-cursor {
  color: #FF6B35;
  font-size: 29rpx;
  animation: blink 1s step-start infinite;
}
@keyframes blink { 50% { opacity: 0; } }

/* 快捷提问（旧版横滑样式保留，新版用 .quick-panel） */
.quick-row {
  display: flex;
  flex-wrap: nowrap;
  white-space: nowrap;
  padding: 0 24rpx 16rpx;
}
.quick-row .quick-chip {
  flex-shrink: 0;
  margin-right: 16rpx;
}

/* 输入栏 */
.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0ece8;
}
.chat-input {
  flex: 1;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 38rpx;
  background: #f5f1ec;
  font-size: 28rpx;
  color: #2E2A26;
}
.chat-send {
  width: 128rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: #FF6B35;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.chat-send.disabled {
  background: #e0d8d0;
  color: #a8998c;
}

/* 消息包装：气泡 + 依据区 */
.msg-wrap {
  display: flex;
  flex-direction: column;
  max-width: 74%;
  margin: 0 16rpx;
}
.msg-user .msg-wrap { align-items: flex-end; }
.msg-wrap .msg-bubble { max-width: 100%; margin: 0; }
.msg-bubble.failed {
  background: #FFF3F0;
  border: 1rpx solid #FFD5CC;
}

/* 检索依据：可核查性是产品的差异化，不要藏起来 */
.msg-src {
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  background: #FAF6F2;
  border-radius: 12rpx;
  border: 1rpx solid #F0E7DE;
}
.src-toggle {
  font-size: 22rpx;
  color: #A08D7C;
}
.src-list { margin-top: 8rpx; }
.src-item {
  display: flex;
  flex-direction: column;
  padding: 8rpx 0;
  border-top: 1rpx dashed #EADFD4;
}
.src-item:first-child { border-top: none; }
.src-title {
  font-size: 24rpx;
  color: #5C5148;
  font-weight: 600;
}
.src-meta {
  font-size: 21rpx;
  color: #A08D7C;
  margin-top: 2rpx;
}

/* 分组快捷提问：按意图分组，新人不用想「该问什么」 */
.quick-panel {
  padding: 12rpx 24rpx 16rpx;
  background: #fff;
  border-top: 1rpx solid #f5f1ec;
}
.quick-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.quick-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 14rpx;
  background: #FAF6F2;
  font-size: 24rpx;
  color: #8C7F74;
  border: 1rpx solid transparent;
}
.quick-tab.on {
  background: #FFF1E9;
  color: #FF6B35;
  font-weight: 700;
  border-color: #FFD5C2;
}
.qt-icon {
  margin-right: 4rpx;
  font-size: 22rpx;
}
.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.quick-chip {
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 1rpx solid #FFC5AB;
  color: #FF6B35;
  font-size: 25rpx;
  line-height: 1.3;
}

/* 停止生成：同一个按钮换个样子，不新增控件 */
.chat-send.stop {
  background: #2E2A26;
  color: #fff;
}

/* 已停止的标记 */
.msg-bubble.stopped {
  background: #FAF6F2;
  border: 1rpx dashed #E2D5C9;
}
.msg-stamp {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #B3A79C;
}

/* 重试 */
.msg-retry {
  margin-top: 10rpx;
  align-self: flex-start;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  background: #FFF1E9;
  color: #FF6B35;
  font-size: 23rpx;
  border: 1rpx solid #FFD5C2;
}

/* 底部说明 */
.kb-foot {
  text-align: center;
  font-size: 21rpx;
  color: #B3A79C;
  padding: 0 24rpx 12rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: #fff;
}
