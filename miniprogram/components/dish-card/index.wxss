.dish-card {
  background: var(--bg-surface);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-sm);
  padding: 30rpx;
  margin-bottom: 24rpx;
  position: relative; overflow: hidden;
}
.dish-card.warn::before, .dish-card.risk::before {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 6rpx;
}
.dish-card.warn::before { background: var(--warning); }
.dish-card.risk::before { background: var(--danger); }

.dc-head { display: flex; align-items: flex-start; }
.dc-thumb {
  width: 116rpx; height: 116rpx; border-radius: 26rpx;
  flex-shrink: 0; margin-right: 20rpx;
  background: var(--bg-elevated); overflow: hidden;
  position: relative;
}

/* 缩略图：一只小碟子 */
.dish-art { width: 100%; height: 100%; position: relative; }
.dish-art::before {
  content: ''; position: absolute; left: 50%; top: 52%;
  width: 62%; height: 62%; margin: -31% 0 0 -31%;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 34%, #fff 0%, #FFF7F0 52%, #EFE0D2 100%);
  box-shadow: 0 2rpx 8rpx rgba(90,50,20,.18);
}
.dish-art::after {
  content: ''; position: absolute; left: 50%; top: 54%;
  width: 30%; height: 26%; margin: 0 0 0 -15%;
  border-radius: 48% 52% 46% 54%;
  background: radial-gradient(circle at 36% 32%, var(--fdA, #F0B45C), var(--fdB, #C4622A));
  box-shadow: 16rpx 12rpx 0 -4rpx var(--fdC, #6E9B3C), -14rpx -10rpx 0 -6rpx var(--fdD, #E4B94E);
}

.dc-info { flex: 1; min-width: 0; }
.dc-name-row { display: flex; align-items: baseline; }
.dc-name { font-size: 34rpx; font-weight: 600; color: var(--text-primary); }
.dc-price { font-size: 34rpx; font-weight: 600; margin-left: auto; }
.dc-en { font-size: 24rpx; color: var(--text-tertiary); margin-top: 4rpx; }
.dc-conf { display: flex; align-items: center; margin-top: 10rpx; }

.dc-desc { font-size: 28rpx; color: var(--text-secondary); margin-top: 18rpx; line-height: 1.55; }

.dc-note {
  font-size: 25rpx; margin-top: 16rpx; padding: 14rpx 20rpx;
  border-radius: 20rpx; display: flex; gap: 12rpx; align-items: flex-start;
}
.dc-note.warn { background: #FFF8E8; color: #8A6410; }
.dc-note.risk { background: #FEF0F0; color: #A32327; }

.dc-meta { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }

.dc-expand {
  margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx dashed var(--divider);
}
.dc-row { display: flex; font-size: 26rpx; margin-bottom: 12rpx; }
.dc-row .k { color: var(--text-tertiary); width: 140rpx; flex-shrink: 0; }
.dc-row .v { color: var(--text-primary); flex: 1; }

.cand-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.cand-item {
  padding: 14rpx 26rpx; border-radius: 20rpx;
  border: 1rpx solid var(--divider); font-size: 27rpx; color: var(--text-primary);
}
.cand-item:active { border-color: var(--brand-primary); color: var(--brand-primary); }

.dc-foot {
  display: flex; align-items: center; gap: 24rpx;
  margin-top: 22rpx; padding-top: 22rpx; border-top: 1rpx solid var(--divider);
}
.recipe-link { font-size: 28rpx; font-weight: 600; color: var(--brand-primary); }
.fix-btn { margin-left: auto; font-size: 26rpx; color: var(--text-tertiary); }
.fix-btn:first-of-type { margin-left: auto; }
.dc-foot .fix-btn + .fix-btn { margin-left: 0; }