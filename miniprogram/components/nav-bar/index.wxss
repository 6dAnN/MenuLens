.navbar {
  position: fixed; left: 0; right: 0; top: 0;
  height: 88rpx;
  display: flex; align-items: center;
  padding-left: 24rpx; padding-right: 24rpx;
  z-index: 100;
  box-sizing: content-box;
}
.navbar-bg { background: var(--bg-primary, #FFFBF7); }
.navbar-fg { background: transparent; color: #fff; }

.nav-btn {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; line-height: 1;
  color: inherit;
}
.nav-btn:active { opacity: 0.5; }

.nav-title {
  flex: 1; text-align: center;
  font-size: 34rpx; font-weight: 600;
  color: inherit;
}
.nav-right { display: flex; }