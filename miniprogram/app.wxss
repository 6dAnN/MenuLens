/**
 * MenuLens 设计系统 · 小程序端变量
 * 严格对齐 docs/UI-UX-设计规范.md §2
 * 使用 wxss 的 CSS 变量（基础库 2.x+ 支持）
 */
page {
  /* 品牌色 */
  --brand-primary: #FF6B35;
  --brand-primary-hover: #F0551F;
  --brand-secondary: #FFA94D;
  --brand-gradient: linear-gradient(135deg, #FF6B35 0%, #FFA94D 100%);

  /* 背景表面 */
  --bg-primary: #FFFBF7;
  --bg-surface: #FFFFFF;
  --bg-elevated: #FFF4EC;
  --bg-brand-soft: #FFF0E8;

  /* 文字 */
  --text-primary: #2B2118;
  --text-secondary: #7A6A5D;
  --text-tertiary: #A8998C;
  --text-on-brand: #FFFFFF;

  /* 语义 */
  --success: #2FA84F;
  --warning: #F5A524;
  --danger: #E5484D;

  --divider: #F0E6DC;
  --shadow-sm: 0 2rpx 8rpx rgba(43, 33, 24, 0.06);
  --shadow-md: 0 6rpx 20rpx rgba(43, 33, 24, 0.10);
  --shadow-lg: 0 12rpx 40rpx rgba(43, 33, 24, 0.14);
  --brand-shadow: 0 6rpx 16rpx rgba(255, 107, 53, 0.28);

  /* 圆角 */
  --r-card: 40rpx;
  --r-button: 28rpx;
  --r-input: 28rpx;
  --r-badge: 16rpx;
  --r-pill: 999rpx;

  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: "PingFang SC", -apple-system, "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

/* ---------- 通用工具类 ---------- */
.page { padding: 0 40rpx 60rpx; }
.pad-bottom { height: calc(32rpx + env(safe-area-inset-bottom)); }

.card {
  background: var(--bg-surface);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-sm);
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx; font-weight: 600;
  margin: 44rpx 0 20rpx;
  display: flex; align-items: center;
}
.section-title .st-sub {
  margin-left: auto; font-size: 26rpx;
  font-weight: 400; color: var(--text-tertiary);
}

/* ---------- 按钮 ---------- */
.btn-primary {
  height: 112rpx;
  background: var(--brand-gradient);
  color: var(--text-on-brand);
  border-radius: var(--r-button);
  font-size: 34rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--brand-shadow);
  border: none;
}
.btn-primary::after { border: none; }
.btn-primary:active { opacity: 0.9; transform: scale(0.99); }
.btn-primary[disabled] { opacity: 0.4; }

.btn-secondary {
  height: 96rpx; line-height: 96rpx;
  background: var(--bg-elevated); color: var(--text-primary);
  border-radius: var(--r-button); font-size: 30rpx; font-weight: 600;
  text-align: center; border: none;
}
.btn-secondary::after { border: none; }

.btn-ghost {
  color: var(--text-secondary); font-size: 28rpx;
  padding: 16rpx 20rpx; background: transparent;
}
.btn-ghost::after { border: none; }

/* ---------- Chip ---------- */
.chip {
  display: inline-flex; align-items: center;
  height: 68rpx; padding: 0 28rpx;
  border-radius: var(--r-pill);
  border: 1rpx solid var(--divider);
  background: transparent; color: var(--text-secondary);
  font-size: 28rpx; margin: 0 16rpx 16rpx 0;
  transition: all 0.18s;
}
.chip.on {
  background: var(--bg-brand-soft); color: var(--brand-primary);
  border-color: var(--brand-primary); font-weight: 600;
}

/* ---------- Pill ---------- */
.pill {
  display: inline-block; padding: 4rpx 18rpx;
  border-radius: var(--r-badge); font-size: 24rpx; font-weight: 600;
}
.pill.cat { background: var(--bg-brand-soft); color: var(--brand-primary); }
.pill.mild { background: #F2F6F2; color: var(--success); }
.pill.risk { background: #FEF0F0; color: var(--danger); }
.pill.warn { background: #FFF8E8; color: #8A6410; }

/* ---------- 提示条 ---------- */
.notice-bar {
  display: flex; align-items: flex-start;
  padding: 20rpx 28rpx; border-radius: 24rpx;
  font-size: 26rpx; line-height: 1.55; margin-bottom: 24rpx;
}
.notice-bar.warn { background: #FFF8E8; color: #8A6410; }
.notice-bar.danger { background: #FEF0F0; color: #A32327; }
.notice-bar.info { background: var(--bg-brand-soft); color: #8A4A20; }
.notice-bar .nb-x { margin-left: auto; padding-left: 20rpx; }

/* ---------- 置信度点阵 ---------- */
.conf-dots { display: flex; }
.conf-dots .d {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  margin-right: 5rpx; background: var(--divider);
}
.conf-dots .d.on.hi { background: var(--success); }
.conf-dots .d.on.mid { background: var(--warning); }
.conf-dots .d.on.lo { background: var(--danger); }
.conf-txt { font-size: 22rpx; font-weight: 600; margin-left: 12rpx; }
.conf-txt.hi { color: var(--success); }
.conf-txt.mid { color: #C4860F; }
.conf-txt.lo { color: var(--danger); }
.conf-src { margin-left: auto; font-size: 22rpx; color: var(--text-tertiary); }

/* ---------- 自定义导航栏（沉浸式） ---------- */
.navbar {
  position: fixed; left: 0; right: 0; top: 0;
  height: 88rpx; padding-top: env(safe-area-inset-top);
  box-sizing: content-box;
  display: flex; align-items: center;
  padding-left: 24rpx; padding-right: 24rpx;
  z-index: 100;
}
.navbar-bg { background: var(--bg-primary); }
.navbar-fg { background: transparent; color: #fff; }
.navbar .nav-btn {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
}
.navbar .nav-title {
  flex: 1; text-align: center;
  font-size: 34rpx; font-weight: 600;
}
.navbar-fg .nav-btn { color: #fff; }
.navbar .nav-right { display: flex; }

/* 页面内容顶部留白（避开自定义导航栏） */
.has-navbar { padding-top: calc(88rpx + env(safe-area-inset-top)); }
.has-navbar-hero { padding-top: 0; }