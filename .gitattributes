# 默认按 LF 提交、检出时转成 CRLF（Windows 开发习惯）
* text=auto eol=lf

*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.wxml text eol=lf
*.wxss text eol=lf

# 二进制，不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.docx binary
*.pdf  binary
*.zip  binary
